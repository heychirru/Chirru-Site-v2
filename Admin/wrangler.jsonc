{
    "name": "admin",
    "compatibility_date": "2026-10-16",
    "compatibility_flags": [
        "enable_nodejs_compat"
    ],
    "workers_dev": false,
    "observability": {
        "logs": {
            "enabled": true,
            "head_sampling_rate": 1,
            "invocation_logs": true,
            "persist": true
        },
        "traces": {
            "enabled": false,
            "head_sampling_rate": 1,
            "persist": true
        }
    },
    "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application"
    },
    "vars": {
        "ENVIRONMENT": "production"
    },
    "previews": {
        "vars": {
            "ENVIRONMENT": "preview"
        }
    }
}