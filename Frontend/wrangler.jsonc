{
    "name": "frontend",
    "compatibility_date": "2026-10-02",
    "compatibility_flags": ["nodejs_compat"],
    "pages_build_output_dir": ".vercel/output/static",
    "observability": {
        "logs": {
            "enabled": true,
            "head_sampling_rate": 1,
            "invocation_logs": true,
            "persist": true
        },
        "traces": {
            "enabled": false,
            "head_sampling_rate": 1,
            "persist": true
        }
    },
    "vars": {
        "ENVIRONMENT": "production"
    },
    "previews": {
        "vars": {
            "ENVIRONMENT": "preview"
        }
    }
}